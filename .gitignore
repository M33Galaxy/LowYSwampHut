# ---------------------------------------------------------------------------
# LowYSwampHut 主仓库 .gitignore
#
# 目录布局：
#   src/                          Java GUI / CLI（原 LowYSwampHut-main/ 平摊）
#   build.gradle / settings...    Gradle 主构建
#   LowYSwampHutFinderBase/       C 内核（占位目录，等待 GitHub 仓库创建后转为 submodule）
#   dist/                         发布产物（jar + Base CLI + Base DLL）
# ---------------------------------------------------------------------------

# Gradle
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar

# 发布目录
/dist/
_trash_*/

# 旧 PowerShell 构建中转（保留兼容脚本，但不再作为默认路径）
_scratch/
logs/

# 搜索默认输出
result.txt
hits.txt
dist/result.txt
*.jar.bak

# 临时/归档内容
_scratch2/
probe/
seedCheckerLib/
_verguard_tmp.txt
*.tmp
_archive/

# IDE
/.idea/
*.iml
*.iws
*.ipr
.vscode/
